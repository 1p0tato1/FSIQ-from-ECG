# Copy this file to ".env" (same folder as the notebook) and fill in your own paths.
# The real .env must never be committed.

# ---------------------------------------------------------------------------
# Source data (tab-separated files, even though they end in .csv)
# ---------------------------------------------------------------------------
HRV_LINEAR_FILE="/path/to/HRV_Lineaire_Full.csv"
HRV_NONLINEAR_FILE="/path/to/HRV_NonLineaire_Full.csv"
WPPSI_FILE="/path/to/Resultats_WPPSI_III.csv"

# ---------------------------------------------------------------------------
# Local outputs derived from individual children  -> keep OUT of the repository
# ---------------------------------------------------------------------------
# modelling tables, cross-validation cache, fold-level best hyper-parameters
PROCESSED_DIR="/path/to/local/processed"
# trained pipelines (.joblib) and the fitted scaler
MODELS_DIR="/path/to/local/models"
# figures
PLOTS_DIR="/path/to/local/plots"

# ---------------------------------------------------------------------------
# Aggregated outputs (no individual rows) -> may live inside the repository
# model_comparison.csv, fold_scores.csv, SUMMARY.md, selected feature names, SHAP tables
# ---------------------------------------------------------------------------
RESULTS_DIR="/path/to/repo/results"

# ---------------------------------------------------------------------------
# Optional run settings (the values below are the defaults)
# ---------------------------------------------------------------------------
# Comma-separated list among QIT, QIV, QIP, NCL
TARGETS=QIT
RANDOM_SEED=42
# Outer loop: OUTER_SPLITS folds repeated OUTER_REPEATS times (5 x 10 = 50 fits per model)
OUTER_SPLITS=5
OUTER_REPEATS=10
# Inner loop used for hyper-parameter selection
INNER_SPLITS=5
# Maximum number of hyper-parameter combinations tried per fit
SEARCH_ITERATIONS=50
# Parallel workers for the outer folds (-1 = all cores)
N_JOBS=-1
# 1 = reuse finished model/target runs from the cache folder, 0 = recompute everything
RESUME_RUNS=1
# 1 = run the SHAP feature-count study (needs the "shap" package), 0 = skip it
RUN_SHAP=1
# Largest number of top-ranked predictors examined by the SHAP study
SHAP_MAX_FEATURES=8
